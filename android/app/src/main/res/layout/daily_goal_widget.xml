<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_goal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launch_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/daily_goal_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daily Goal"
        android:textColor="#1B5E20"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_goal_widget_progress_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0 / 24 completed"
        android:textColor="#263238"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/daily_goal_widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/daily_goal_widget_percent_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0%"
        android:textColor="#455A64"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/daily_goal_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Stay alive with healthy choices"
        android:textColor="#607D8B"
        android:textSize="11sp" />
</LinearLayout>
