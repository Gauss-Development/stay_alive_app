# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Optional local overrides (add to pubspec.yaml assets when present)
assets/env/app.env

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing
/android/key.properties
**/*.jks
**/*.keystore

# Release-build secrets (RevenueCat, Sentry, etc.)
/scripts/release.env

# Local tooling — untracked on purpose. Kept on disk, not shared via git.
/scripts/

# Agent session worktrees — scratch copies of the repo, never shared.
/.claude/worktrees/

# QA screenshots — regenerate with `flutter drive` against a local stack.
/screenshots/
