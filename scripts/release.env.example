# Production secrets template.
#
# Copy to scripts/release.env (gitignored) and fill in real values.
# scripts/build-prod.sh feeds this file to Flutter via --dart-define-from-file.

# Supabase hosted project — Dashboard → Project Settings → API.
# The anon/publishable key is safe to embed in the client; RLS is the guard.
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME

# RevenueCat SDK API keys — get from app.revenuecat.com → Project → APIs
REVENUECAT_IOS_API_KEY=appl_REPLACE_ME
REVENUECAT_ANDROID_API_KEY=goog_REPLACE_ME

# RevenueCat entitlement identifier (configured in RC dashboard).
# Stay Alive project uses lookup_key "Stay Alive Pro".
REVENUECAT_ENTITLEMENT_ID=Stay Alive Pro

# RevenueCat offering identifier (defaults to 'default' if unset).
REVENUECAT_OFFERING_ID=default

# Sentry — get DSN from sentry.io → Project → Settings → Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
