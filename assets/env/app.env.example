# Base template for all flavors. Per-flavor overrides: assets/env/app.dev.env,
# assets/env/app.prod.env. Optional local overrides: assets/env/app.env (gitignored).
# Build overrides: --dart-define=KEY=value (takes precedence over .env)

# Supabase backend. Empty here = code fallbacks apply: the local
# `supabase start` stack for dev, FAIL CLOSED (bootstrap throws) for prod.
# Android emulator reaches the local stack via http://10.0.2.2:54321.
# `sb_publishable_...` keys go in SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

REVENUECAT_ANDROID_API_KEY=test_xsTTIBRKlCVdXpltnlImbcuZhVt
REVENUECAT_IOS_API_KEY=test_xsTTIBRKlCVdXpltnlImbcuZhVt
REVENUECAT_ENTITLEMENT_ID=Stay Alive Pro
REVENUECAT_OFFERING_ID=default
DAILY_GOAL_WIDGET_APP_GROUP_ID=group.com.gaussdev.stayalive
